{
  "manifest_version": 3,
  "name": "Nitpicker",
  "version": "0.1.0",
  "description": "Pick UI elements, tag issues, and export a feedback digest.",
  "permissions": ["sidePanel", "activeTab", "scripting", "downloads", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Open Nitpicker", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "commands": {
    "start-picking": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Start picking an element"
    }
  },
  "side_panel": { "default_path": "sidepanel.html" }
}
